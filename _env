# Copy this file to ".env" and fill in your own values.
# NEVER share your .env file or commit it to GitHub — it contains secret keys.

# Any random long password-like string. This keeps user logins secure.
JWT_SECRET=change-this-to-a-long-random-string

# Get these from your own Razorpay account: https://dashboard.razorpay.com/app/keys
# Payments made through this app go straight into THIS Razorpay account (your bank account).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# For auto-pay (recurring subscriptions) to work, create a Webhook in your Razorpay
# Dashboard -> Account & Settings -> Webhooks, pointing to:
#   https://yourdomain.com/api/webhooks/razorpay
# Enable these events: subscription.charged, subscription.activated,
# subscription.authenticated, subscription.cancelled, subscription.halted,
# subscription.completed
# Razorpay will show you a "Webhook Secret" when you create it -- paste it here:
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret-here

# Port the server runs on (most hosts set this automatically, leave as is)
PORT=3000
